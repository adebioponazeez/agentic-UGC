TETRATIVE_ENV=development
# Single-user fallback:
TETRATIVE_SERVER_API_KEY=replace-with-at-least-24-random-characters
# Preferred multi-principal configuration (JSON on one line):
# TETRATIVE_API_KEYS_JSON={"operator-secret-at-least-24":{"subject":"ops@example.com","tenant":"acme","roles":["operator","viewer"]},"approver-secret-at-least-24":{"subject":"reviewer@example.com","tenant":"acme","roles":["approver","viewer"]}}
TETRATIVE_DEFAULT_MOCK=true
TETRATIVE_PORT=8000
TETRATIVE_BASE_URL=http://localhost:11434/v1
TETRATIVE_MODEL=qwen3:8b
TETRATIVE_API_KEY=local
TETRATIVE_DATA_DIR=.tetrative
